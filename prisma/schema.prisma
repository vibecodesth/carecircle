// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]

  // CareCircle relations
  circles       CircleMember[]
  createdCircles Circle[]      @relation("CircleCreator")
  shiftsClaimed  Shift[]
  medicationLogs MedicationLog[]
  timelineEvents MedicalEvent[]
  expenses       Expense[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// CareCircle models
model Circle {
  id          String         @id @default(cuid())
  name        String
  inviteCode  String         @unique
  createdById String
  createdBy   User           @relation("CircleCreator", fields: [createdById], references: [id])
  members     CircleMember[]
  parents     Parent[]
  shifts      Shift[]
  medications Medication[]
  timeline    MedicalEvent[]
  expenses    Expense[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CircleMember {
  id       String   @id @default(cuid())
  circleId String
  userId   String
  role     String   @default("member") // admin, member

  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([circleId, userId])
}

model Parent {
  id                String   @id @default(cuid())
  circleId          String
  name              String
  age               Int?
  address           String?
  healthConditions  String?  // JSON array as string
  primaryDoctorName String?
  primaryDoctorPhone String?
  emergencyContact  String?  // JSON object as string

  circle            Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([circleId])
}

model Shift {
  id          String    @id @default(cuid())
  circleId    String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  recurring   String?   // NONE, DAILY, WEEKLY, MONTHLY
  claimedById String?

  circle      Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  claimedBy   User?     @relation(fields: [claimedById], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Medication {
  id          String          @id @default(cuid())
  circleId    String
  name        String
  dosage      String
  frequency   String
  timeOfDay   String          // JSON array as string

  circle      Circle          @relation(fields: [circleId], references: [id], onDelete: Cascade)
  logs        MedicationLog[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MedicationLog {
  id           String     @id @default(cuid())
  medicationId String
  givenById    String
  givenAt      DateTime
  notes        String?

  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  givenBy      User       @relation(fields: [givenById], references: [id])

  createdAt    DateTime   @default(now())
}

model MedicalEvent {
  id          String   @id @default(cuid())
  circleId    String
  createdById String
  date        DateTime
  type        String   // DOCTOR_VISIT, ER, HOSPITAL, TEST, OTHER
  doctorName  String?
  notes       String?

  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  circleId    String
  paidById    String
  amount      Float
  category    String   // MEDICAL, SUPPLIES, FOOD, TRANSPORT, OTHER
  description String?
  date        DateTime

  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  paidBy      User     @relation(fields: [paidById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
